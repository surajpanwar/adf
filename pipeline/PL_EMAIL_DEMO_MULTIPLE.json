{
	"name": "PL_EMAIL_DEMO_MULTIPLE",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare Logic App Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-31.southeastasia.logic.azure.com:443/workflows/48e08da96fde47fe88c7bfa611541490/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=T_RZkwyvxCH9FhBniWfUJWaMNk5XAKTERk1zkk_hKIw",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Logic App Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\"email_recepient\":\"@{pipeline().parameters.email_recepient}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"body\": \"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "@concat(\n    'Ingestion process has been completed for all tables and below is the status:',\n    '\\n',\n    replace(string(pipeline().parameters.table_status), '\"', ''),\n    '\\n\\n',\n    'Pipeline Parent ID: ',\n    pipeline()?.TriggeredByPipelineRunId\n)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-26T07:52:42Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}